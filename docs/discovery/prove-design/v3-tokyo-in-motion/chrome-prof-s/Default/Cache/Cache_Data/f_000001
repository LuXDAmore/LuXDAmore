<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"></head><body>
<title>Tokyo in Motion</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Dela+Gothic+One&family=IBM+Plex+Mono:wght@400;500&family=Zen+Kaku+Gothic+New:wght@400;700&display=swap">
<style>
/* Layout: photographs scattered at three depths, ordered by colour from blue hour to neon red, drifting vertically; behind them, traffic light trails crossing horizontally. */
:root {
  --night: #030408;
  --ink: #eef1f7;
  --dim: #8b91a2;
  --signal: #ff3346;
  --display: "Zen Kaku Gothic New", "Hiragino Kaku Gothic ProN", "Yu Gothic", system-ui, sans-serif;
  --mono: "IBM Plex Mono", ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
  --title: "Dela Gothic One", "Zen Kaku Gothic New", "Hiragino Kaku Gothic ProN", system-ui, sans-serif;
  color-scheme: dark;
}
html, body { height: 100%; background: var(--night); color: var(--ink); overflow: hidden; }
body {
  font-family: var(--display);
  padding-left: max(16px, env(safe-area-inset-left, 0px));
  padding-right: max(16px, env(safe-area-inset-right, 0px));
  -webkit-font-smoothing: antialiased;
  overscroll-behavior: none;
  touch-action: none;
}
#gl { position: fixed; inset: 0; width: 100%; height: 100%; display: block; }

.top {
  position: fixed; left: 0; right: 0; top: 0; z-index: 2;
  display: flex; align-items: center; justify-content: space-between; gap: 16px;
  padding-top: calc(env(safe-area-inset-top, 0px) + 18px);
  padding-left: max(20px, env(safe-area-inset-left, 0px));
  padding-right: max(20px, env(safe-area-inset-right, 0px));
}
.name { font-weight: 700; font-size: 13px; letter-spacing: .04em; }
nav { display: flex; gap: 22px; }
nav a, .lang button {
  color: var(--dim); text-decoration: none; font-size: 13px; letter-spacing: .06em;
  background: none; border: 0; padding: 4px 0; cursor: pointer; font-family: inherit;
}
nav a[aria-current="page"] { color: var(--ink); }
nav a[aria-current="page"]::before { content: ""; display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: var(--signal); margin-right: 8px; vertical-align: 2px; box-shadow: 0 0 10px var(--signal); }
nav a[aria-disabled="true"] { cursor: default; }
.lang { display: flex; gap: 10px; }
.lang button { font-family: var(--mono); font-size: 12px; }
.lang button[aria-pressed="true"] { color: var(--ink); }
a:focus-visible, button:focus-visible { outline: 1px solid var(--signal); outline-offset: 4px; }

.intro {
  position: fixed; z-index: 1; inset: 0;
  display: grid; place-content: center; justify-items: center; gap: 18px;
  padding-left: max(20px, env(safe-area-inset-left, 0px));
  padding-right: max(20px, env(safe-area-inset-right, 0px));
  text-align: center; pointer-events: none; will-change: transform;
}
.eyebrow { margin: 0; font-family: var(--mono); font-size: 12px; letter-spacing: .2em; text-transform: uppercase; color: var(--dim); }
h1 { margin: 0; font-family: var(--title); font-weight: 400; line-height: .92; letter-spacing: -.01em; font-size: clamp(52px, 11.5vw, 190px); text-wrap: balance; text-shadow: 0 2px 50px rgba(3, 4, 8, .8); }
h1 span { display: block; }

.sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
.no-gl body { overflow: auto; touch-action: auto; }
.no-gl #gl { display: none; }
.no-gl .intro { transform: none !important; }
.no-gl .gallery { position: static; width: auto; height: auto; clip: auto; overflow: visible; white-space: normal; display: grid; gap: 24px; padding-block: 70vh 120px; max-width: 720px; margin: 0 auto; list-style: none; }
.no-gl .gallery img { width: 100%; height: auto; display: block; }

@media (max-width: 720px) {
  nav { gap: 14px; }
  .name { display: none; }
}
</style>

<canvas id="gl" aria-hidden="true"></canvas>

<header class="top">
  <span class="name">Luca Iaconelli</span>
  <nav aria-label="Main">
    <a href="#colors" aria-disabled="true" data-i18n="colors">Colors</a>
    <a href="#exhibitions" aria-current="page" data-i18n="exhibitions">Exhibitions</a>
  </nav>
  <div class="lang" role="group" aria-label="Language">
    <button type="button" id="lang-en" aria-pressed="true">EN</button>
    <button type="button" id="lang-it" aria-pressed="false">IT</button>
  </div>
</header>

<main>
  <section class="intro" id="intro">
    <p class="eyebrow" data-i18n="eyebrow">Exhibition 01 · Tokyo, 2017–2026</p>
    <h1><span>Tokyo</span><span>in Motion</span></h1>
  </section>
  <ol class="gallery sr-only" id="gallery" aria-label="Photographs"></ol>
</main>

<script>
(() => {
  // ---------- copy: English first, Italian second ----------
  const COPY = {
    en: {
      colors: 'Colors', exhibitions: 'Exhibitions',
      eyebrow: 'Exhibition 01 · Tokyo, 2017–2026',
      alt: n => `Tokyo, long exposure, frame ${n}`,
    },
    it: {
      colors: 'Colori', exhibitions: 'Mostre',
      eyebrow: 'Mostra 01 · Tokyo, 2017–2026',
      alt: n => `Tokyo, posa lunga, scatto ${n}`,
    },
  };
  function setLang(l) {
    document.documentElement.lang = l;
    document.querySelectorAll('[data-i18n]').forEach(el => { el.textContent = COPY[l][el.dataset.i18n]; });
    document.getElementById('lang-en').setAttribute('aria-pressed', l === 'en');
    document.getElementById('lang-it').setAttribute('aria-pressed', l === 'it');
    document.querySelectorAll('#gallery img').forEach((img, i) => { img.alt = COPY[l].alt(i + 1); });
  }
  document.getElementById('lang-en').addEventListener('click', () => setLang('en'));
  document.getElementById('lang-it').addEventListener('click', () => setLang('it'));
  document.querySelector('a[aria-disabled="true"]').addEventListener('click', e => e.preventDefault());

  // ---------- photographs, with the dominant hue of each (measured beforehand) ----------
  const SIZES = [[958,1280],[958,1280],[958,1280],[1280,854],[1280,854],[1280,854],[1280,854],[1280,854],[1280,854],[1280,854],[1280,854],[854,1280],[1280,854],[1280,854],[1280,854],[1280,854],[1280,854],[1280,854],[854,1280],[854,1280],[1280,854],[1280,854],[1280,854],[1280,854],[854,1280],[1280,854],[1280,854],[1280,854],[854,1280],[1280,854],[854,1280],[1280,854],[1280,854],[854,1280],[1280,848],[1280,854]];
  const HUES = [137,118,40,30,22,43,31,353,13,33,201,230,23,27,34,12,37,34,38,42,52,160,239,211,207,242,58,211,211,28,32,32,338,15,57,26];
  const rnd = (i, k) => { const x = Math.sin(i * 127.1 + k * 311.7) * 43758.5453; return x - Math.floor(x); };
  // colour journey: blue hour → green → yellow → amber → red neon
  const hueKey = h => h >= 180 && h < 300 ? (260 - h) / 80 : h >= 90 && h < 180 ? 1 + (180 - h) / 90 : h < 90 ? 2 + (90 - h) / 90 : 3 + (360 - h) / 60;
  const photos = SIZES.map(([w, h], i) => ({ i, src: `img/t${String(i).padStart(2, '0')}.jpg`, ar: w / h, hue: HUES[i], tex: null, ready: false, fade: 0 }));
  const order = [...photos].sort((a, b) => hueKey(a.hue) - hueKey(b.hue));
  const gallery = document.getElementById('gallery');
  order.forEach((p, n) => {
    const li = document.createElement('li'), img = document.createElement('img');
    img.loading = 'lazy'; img.decoding = 'async'; img.src = p.src; img.alt = COPY.en.alt(n + 1);
    li.append(img); gallery.append(li);
  });

  const canvas = document.getElementById('gl');
  const gl = canvas.getContext('webgl2', { antialias: false, alpha: false, premultipliedAlpha: false });
  if (!gl) { document.documentElement.classList.add('no-gl'); return; }
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const DPR = Math.min(window.devicePixelRatio || 1, 2);
  // if the GPU drops the context (a phone sending the tab to the background) the plain gallery shows; when it comes back, start again
  let lost = false;
  canvas.addEventListener('webglcontextlost', e => { e.preventDefault(); lost = true; document.documentElement.classList.add('no-gl'); });
  canvas.addEventListener('webglcontextrestored', () => location.reload());

  // ---------- GL helpers ----------
  function sh(type, src) {
    const s = gl.createShader(type); gl.shaderSource(s, src); gl.compileShader(s);
    if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) throw new Error(gl.getShaderInfoLog(s));
    return s;
  }
  function prog(vs, fs) {
    const p = gl.createProgram();
    gl.attachShader(p, sh(gl.VERTEX_SHADER, vs)); gl.attachShader(p, sh(gl.FRAGMENT_SHADER, fs));
    gl.linkProgram(p);
    if (!gl.getProgramParameter(p, gl.LINK_STATUS)) throw new Error(gl.getProgramInfoLog(p));
    const u = {}; const n = gl.getProgramParameter(p, gl.ACTIVE_UNIFORMS);
    for (let k = 0; k < n; k++) { const info = gl.getActiveUniform(p, k); u[info.name] = gl.getUniformLocation(p, info.name); }
    return { p, u };
  }
  const VS_FULL = `#version 300 es
  layout(location=0) in vec2 p; out vec2 uv;
  void main(){ uv = p; gl_Position = vec4(p*2.-1., 0., 1.); }`;
  const VS_WORLD = `#version 300 es
  layout(location=0) in vec2 p; uniform mat4 vp; uniform vec3 c; uniform vec2 sz; out vec2 uv;
  void main(){ uv = p; vec3 w = c + vec3((p.x - .5)*sz.x, (.5 - p.y)*sz.y, 0.); gl_Position = vp*vec4(w, 1.); }`;

  // the city behind: a glow on the horizon, then light added on top (trails, lamps, signals)
  const FS_HAZE = `#version 300 es
  precision highp float; in vec2 uv; out vec4 o;
  uniform float hy; uniform vec3 tint;
  void main(){
    float d = uv.y - hy;                                   // above the horizon > 0
    vec3 zen = vec3(.005, .006, .014);
    vec3 glow = mix(vec3(.3, .15, .12), tint*.45 + vec3(.04, .035, .07), .5);   // light pollution, tinted by the photograph
    float up = max(d, 0.), dn = max(-d, 0.);
    // continuous at the horizon: the glow rises from the city and fades into the dark sky
    vec3 c = d > 0. ? zen + glow*(.2*exp(-up*10.) + .05*exp(-up*2.5)) : zen + glow*.25*exp(-dn*12.);
    o = vec4(c, 1.);
  }`;
  const FS_COMP = `#version 300 es
  precision highp float; in vec2 uv; out vec4 o;
  uniform sampler2D img; uniform vec2 res; uniform float t;
  float h2(vec2 q){ return fract(sin(dot(q, vec2(12.9898, 78.233)))*43758.5453); }
  vec3 filmic(vec3 x){ return clamp((x*(2.51*x + .03))/(x*(2.43*x + .59) + .14), 0., 1.); }
  void main(){
    vec3 c = filmic(texture(img, uv).rgb*.95);
    vec2 q = uv - .5;
    c *= mix(.72, 1., smoothstep(.95, .2, length(q*vec2(1., 1.1))));
    c += (h2(floor(uv*res) + fract(t)*61.) - .5)*(2./255.);   // dither: no bands in the dark gradients
    o = vec4(c, 1.);
  }`;
  // a light trail: a ribbon around the projected path, bright core and soft halo
  const VS_RIB = `#version 300 es
  layout(location=0) in vec2 pos; layout(location=1) in float ac; layout(location=2) in vec3 col; layout(location=3) in float aam;
  uniform vec2 res; out float a; out float am; out vec3 c;
  void main(){ a = ac; am = aam; c = col; vec2 q = pos/res*2. - 1.; gl_Position = vec4(q.x, -q.y, 0., 1.); }`;
  const FS_RIB = `#version 300 es
  precision highp float; in float a; in float am; in vec3 c; out vec4 o;
  void main(){ float k = exp(-a*a), h = .2/(1. + a*a*.45), e = 1. - clamp(abs(a)/max(am, 1e-3), 0., 1.); o = vec4(c*(k + h)*e*e, 1.); }`;
  // a point of light: street lamps, traffic signals, a car standing still while the shutter is open
  const VS_PT = `#version 300 es
  layout(location=0) in vec2 pos; layout(location=1) in float size; layout(location=2) in vec3 col;
  uniform vec2 res; uniform float dpr; out vec3 c; out float st; out float bk;
  void main(){ c = col; float sz = abs(size); bk = sz > 999. ? 1. : 0.; st = size < 0. ? 1. : 0.; vec2 q = pos/res*2. - 1.; gl_Position = vec4(q.x, -q.y, 0., 1.); gl_PointSize = (sz - bk*1000.)*dpr; }`;
  const FS_PT = `#version 300 es
  precision highp float; in vec3 c; in float st; in float bk; out vec4 o;
  void main(){
    vec2 q = gl_PointCoord*2. - 1.; float r2 = dot(q, q); if (r2 > 1.) discard;
    float r = sqrt(r2), a = atan(q.y, q.x);
    if (bk > .5) { o = vec4(c*(smoothstep(1., .8, r)*.78 + smoothstep(.6, .92, r)*smoothstep(1., .92, r)*.18), 1.); return; }
    float core = exp(-r2*(st > .5 ? 70. : 5.)), halo = (st > .5 ? .16 : .25)*exp(-r2*(st > .5 ? 10. : 1.5));
    float star = st*pow(abs(cos(7.*a)), 90.)*exp(-r*3.)*.6;
    o = vec4(c*(core + halo + star)*(1. - r2), 1.);
  }`;

  // a very light trail behind the photo, made from the photo's own edge, as if the camera caught it moving
  const FS_TRAIL = `#version 300 es
  precision highp float; in vec2 uv; out vec4 o;
  uniform sampler2D tex; uniform float below; uniform float inten; uniform float dim;
  void main(){
    float s = below > .5 ? uv.y : 1. - uv.y;
    vec3 acc = vec3(0.);
    for (int i = 0; i < 6; i++) {
      float v = float(i)/5.*.07;
      acc += texture(tex, vec2(uv.x, below > .5 ? 1. - v : v)).rgb;
    }
    vec3 c = acc/6.;
    float a = inten*pow(1. - s, 2.2)*smoothstep(0., .04, uv.x)*smoothstep(0., .04, 1. - uv.x);
    o = vec4(c*dim, a);
  }`;

  // the photograph: always sharp
  const FS_PHOTO = `#version 300 es
  precision highp float; in vec2 uv; out vec4 o;
  uniform sampler2D tex; uniform float alpha; uniform float dim;
  void main(){
    vec3 c = texture(tex, uv).rgb;
    vec2 e = smoothstep(vec2(0.), vec2(.004), uv)*smoothstep(vec2(0.), vec2(.004), 1. - uv);
    o = vec4(c*dim, alpha*e.x*e.y);
  }`;

  const P = { comp: prog(VS_FULL, FS_COMP), haze: prog(VS_FULL, FS_HAZE), rib: prog(VS_RIB, FS_RIB), pt: prog(VS_PT, FS_PT), trail: prog(VS_WORLD, FS_TRAIL), photo: prog(VS_WORLD, FS_PHOTO) };
  const vao = gl.createVertexArray();
  gl.bindVertexArray(vao);
  const quad = gl.createBuffer();
  gl.bindBuffer(gl.ARRAY_BUFFER, quad);
  gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([0,0, 1,0, 0,1, 1,1]), gl.STATIC_DRAW);
  gl.enableVertexAttribArray(0);
  gl.vertexAttribPointer(0, 2, gl.FLOAT, false, 0, 0);

  photos.forEach(p => {
    const img = new Image();
    img.decoding = 'async';
    img.onload = () => {
      const t = gl.createTexture();
      gl.activeTexture(gl.TEXTURE0);
      gl.bindTexture(gl.TEXTURE_2D, t);
      gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, img);
      gl.generateMipmap(gl.TEXTURE_2D);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR_MIPMAP_LINEAR);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
      p.tex = t; p.ready = true;
    };
    img.src = p.src;
  });

  // ---------- the city behind: an intersection seen from the corner ----------
  // Units are metres. Every vehicle follows a fixed route (straight on, or a turn), can change lane,
  // keeps its distance (IDM car-following), stops at red lights. Its trail is the real history of its
  // positions during the exposure: lane changes, turns and braking all show in the shape of the light.
  const rr = Math.random;
  const TEXP = 1.5;                      // seconds of exposure behind every trail
  const LIGHT = .16;                     // size of a lamp, metres
  const VSTRIDE = 6, RSTRIDE = 7, MAXV = 120000, MAXP = 4000;
  const ribData = new Float32Array(MAXV * RSTRIDE), ptData = new Float32Array(MAXP * VSTRIDE);
  let ribCount = 0, ptCount = 0;
  function dynVAO(bytes, rib) {
    const a = gl.createVertexArray(); gl.bindVertexArray(a);
    const b = gl.createBuffer(); gl.bindBuffer(gl.ARRAY_BUFFER, b); gl.bufferData(gl.ARRAY_BUFFER, bytes, gl.DYNAMIC_DRAW);
    const st = rib ? 28 : 24;
    gl.enableVertexAttribArray(0); gl.vertexAttribPointer(0, 2, gl.FLOAT, false, st, 0);
    gl.enableVertexAttribArray(1); gl.vertexAttribPointer(1, 1, gl.FLOAT, false, st, 8);
    if (rib) { gl.enableVertexAttribArray(3); gl.vertexAttribPointer(3, 1, gl.FLOAT, false, st, 12); }
    gl.enableVertexAttribArray(2); gl.vertexAttribPointer(2, 3, gl.FLOAT, false, st, rib ? 16 : 12);
    gl.bindVertexArray(vao);
    return { a, b };
  }
  const ribVAO = dynVAO(ribData.byteLength, true), ptVAO = dynVAO(ptData.byteLength, false);
  // the light of the street is accumulated in high dynamic range, like on a sensor
  const floatFB = !!gl.getExtension('EXT_color_buffer_float');
  let bgFB = null;
  function makeFB(w, h) {
    if (bgFB) { gl.deleteTexture(bgFB.tex); gl.deleteFramebuffer(bgFB.fb); }
    const tex = gl.createTexture();
    gl.activeTexture(gl.TEXTURE1); gl.bindTexture(gl.TEXTURE_2D, tex);
    if (floatFB) gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA16F, w, h, 0, gl.RGBA, gl.HALF_FLOAT, null);
    else gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA8, w, h, 0, gl.RGBA, gl.UNSIGNED_BYTE, null);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR); gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE); gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
    const fb = gl.createFramebuffer(); gl.bindFramebuffer(gl.FRAMEBUFFER, fb);
    gl.framebufferTexture2D(gl.FRAMEBUFFER, gl.COLOR_ATTACHMENT0, gl.TEXTURE_2D, tex, 0);
    gl.bindFramebuffer(gl.FRAMEBUFFER, null); gl.activeTexture(gl.TEXTURE0);
    bgFB = { tex, fb };
  }

  // route geometry, sampled every metre
  function line(x0, z0, x1, z1) { const n = Math.max(1, Math.round(Math.hypot(x1 - x0, z1 - z0))), o = []; for (let k = 0; k <= n; k++) o.push([x0 + (x1 - x0) * k / n, z0 + (z1 - z0) * k / n]); return o; }
  const curveX = (x0, x1, z0, amp, per, xc) => line(x0, 0, x1, 0).map(q => [q[0], z0 + amp * Math.sin((q[0] - xc) / per)]);
  const curveZ = (x0, z0, z1, amp, per, zc) => line(0, z0, 0, z1).map(q => [x0 + amp * Math.sin((q[1] - zc) / per), q[1]]);
  function arc(cx, cz, r, a0, a1) { const n = Math.max(2, Math.round(Math.abs(a1 - a0) * r)), o = []; for (let k = 0; k <= n; k++) { const a = a0 + (a1 - a0) * k / n; o.push([cx + r * Math.cos(a), cz + r * Math.sin(a)]); } return o; }
  function route(parts, opt) {
    const xz = [];
    parts.forEach(pp => pp.forEach((q, k) => { if (k || !xz.length) xz.push(q); }));
    const pts = [], cum = [0];
    for (let k = 0; k < xz.length; k++) {
      const a = xz[Math.max(0, k - 1)], b = xz[Math.min(xz.length - 1, k + 1)];
      const tx = b[0] - a[0], tz = b[1] - a[1], l = Math.hypot(tx, tz) || 1;
      const y = opt.y ? opt.y(xz[k][0], xz[k][1]) : .22 * Math.sin(xz[k][0] / 37 + xz[k][1] / 29);
      pts.push({ x: xz[k][0], y, z: xz[k][1], nx: -tz / l, nz: tx / l });
      if (k) cum.push(cum[k - 1] + Math.hypot(xz[k][0] - xz[k - 1][0], xz[k][1] - xz[k - 1][1]));
    }
    return { pts, cum, len: cum[cum.length - 1], ...opt };
  }
  function at(r, s) {
    const c = r.cum; let lo = 0, hi = c.length - 1;
    if (s <= 0) return r.pts[0]; if (s >= c[hi]) return r.pts[hi];
    while (hi - lo > 1) { const m = (lo + hi) >> 1; if (c[m] <= s) lo = m; else hi = m; }
    const f = (s - c[lo]) / (c[hi] - c[lo] || 1), a = r.pts[lo], b = r.pts[hi];
    return { x: a.x + (b.x - a.x) * f, y: a.y + (b.y - a.y) * f, z: a.z + (b.z - a.z) * f, nx: a.nx, nz: a.nz };
  }

  // the network: avenue A and the cross street C meet in front of us; avenue B further back; an elevated highway; a far avenue
  const RED = [1, .07, .16], WHITE = [.93, .95, 1], AMBER = [1, .55, .1];
  const R = 6;
  const hwY = (x, z) => 15 + 1.2 * Math.sin(x / 90);
  const hwZ = x => 52 + 6 * Math.sin(x / 70);
  const routes = {
    AE: route([curveX(-340, 340, 34.5, 2.2, 150, 10)], { origin: 'AE', lanes: [-1.6, 1.6], stops: [{ s: 340 + 2, sig: 'A' }], col: RED, rate: 0.10 }),
    AEturn: route([curveX(-340, 13.5 - R, 34.5, 2.2, 150, 10), arc(13.5 - R, 34.5 + R, R, -Math.PI / 2, 0), curveZ(13.5, 34.5 + R, 380, 1.8, 160, 32)], { origin: 'AE', lanes: [-1.6, 1.6], stops: [{ s: 340 + 2, sig: 'A' }], col: RED, rate: 0.03 }),
